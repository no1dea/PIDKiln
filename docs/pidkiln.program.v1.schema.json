{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pidkiln.local/schemas/pidkiln.program.v1.schema.json",
  "title": "pidkiln.program/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "steps"],
  "properties": {
    "schema": {
      "const": "pidkiln.program/v1"
    },
    "name": {
      "type": "string",
      "maxLength": 31
    },
    "description": {
      "type": "string",
      "maxLength": 159
    },
    "assume_start_c": {
      "description": "Optional hint for rate-based step 0 when no kiln reading is used. No firmware default.",
      "type": "integer",
      "minimum": 0,
      "maximum": 1350
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_c", "hold_min"],
        "properties": {
          "target_c": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1350
          },
          "hold_min": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "ramp_min": {
            "description": "Minutes to reach target_c (exactly one of ramp_min or rate_c_per_h).",
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "rate_c_per_h": {
            "description": "Ramp rate °C/h; >=9999 means full power (togo=1). Exactly one of ramp_min or rate_c_per_h.",
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "oneOf": [
          { "required": ["ramp_min"], "not": { "required": ["rate_c_per_h"] } },
          { "required": ["rate_c_per_h"], "not": { "required": ["ramp_min"] } }
        ]
      }
    }
  }
}
